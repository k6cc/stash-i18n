diff --git a/src/i18n.js b/src/i18n.js
new file mode 100644
index 0000000..6a5d58a
--- /dev/null
+++ b/src/i18n.js
@@ -0,0 +1,85 @@
+// i18n 脚手架（XenithI18n）：界面文案跟随 Stash 界面语言（中文/英文）。
+//
+// _intlLocale 只在桥接组件的 useEffect 里写入 —— 早于它渲染/构建的静态 DOM
+// （导航入口、模态外壳、移动端导航条）会停在英文，需要靠 onLocaleReady 注册的
+// 回填函数（main.js 的 refreshStaticLabels）在语言就绪后修正。
+// 桥接失败时 _intlLocale 保持为空 → tc() 降级英文，任何情况下都不会出现空白文案。
+
+export const PLUGIN_VERSION = "3.2.1";
+
+let _intlLocale = "";
+
+/** 中文为第一参数，英文为第二参数；locale 未就绪或非 zh 时返回英文。 */
+export function tc(zh, en) {
+  return _intlLocale.indexOf("zh") === 0 ? zh : en;
+}
+
+export function isZh() {
+  return _intlLocale.indexOf("zh") === 0;
+}
+
+/**
+ * 表项/选项的显示名（labelZh 优先于 label，shortZh 优先于 short）。
+ * 供 Sidebar/OptionSheet 等以「表项对象」驱动的渲染点使用，避免把中文界面冻在英文。
+ */
+export function localized(entry, key = "label") {
+  if (!entry) return undefined;
+  return isZh() && entry[key + "Zh"] ? entry[key + "Zh"] : entry[key];
+}
+
+/** @type {Array<() => void>} */
+const localeListeners = [];
+
+/** 注册「locale 就绪」回调，用于回填先于 locale 渲染的静态文案。 */
+export function onLocaleReady(fn) {
+  localeListeners.push(fn);
+}
+
+function notifyLocaleReady() {
+  for (const fn of localeListeners) {
+    try {
+      fn();
+    } catch (e) {
+      console.warn("[XenithI18n] static label refresh failed", e);
+    }
+  }
+}
+
+// Bridges Stash's own Intl context into this bundle. The plugin's React tree is
+// portaled into StashApp (see portal-host.js), so patch.before("App") is where
+// a component can sit inside Stash's IntlProvider and read useIntl().
+export function initIntlBridge() {
+  try {
+    const api = window.PluginApi;
+    if (!api || !api.React || !api.patch || !api.libraries || !api.libraries.Intl) return;
+    const React = api.React;
+
+    function IntlBridge() {
+      const intl = api.libraries.Intl.useIntl();
+      // No dep array: runs after every render of the host tree, so a locale
+      // switch in Stash's settings is picked up without a page reload.
+      React.useEffect(() => {
+        const next = intl.locale || "";
+        if (next === _intlLocale) return;
+        _intlLocale = next;
+        notifyLocaleReady();
+      });
+      return null;
+    }
+
+    api.patch.before("App", function (props) {
+      return [
+        {
+          children: React.createElement(
+            React.Fragment,
+            null,
+            React.createElement(IntlBridge),
+            props.children
+          ),
+        },
+      ];
+    });
+  } catch (e) {
+    console.warn("[XenithI18n] i18n bridge failed", e);
+  }
+}
