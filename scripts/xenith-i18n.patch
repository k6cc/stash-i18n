+    if (navBtn.getAttribute("title") !== navLabel) navBtn.setAttribute("title", navLabel);
+  }
+  // 模态外壳 innerHTML 里写死的关闭按钮 aria-label（HTML 结构内的文案）
+  const closeBtn = modalRoot?.querySelector(".hon-modal-close");
+  if (closeBtn) closeBtn.setAttribute("aria-label", tc("关闭", "Close"));
+  // 移动端导航条
+  document.querySelectorAll(".hon-mobile-bar").forEach((bar) => bar.setAttribute("aria-label", navLabel));
+}
+
+// ---- i18n 装配 ----
+// 必须在 init() 之前：App 首次提交后桥接组件就会写入 locale 并回调上面的回填。
+onLocaleReady(refreshStaticLabels);
+initIntlBridge();
+console.log(`[XenithI18n] Xenith I18n v${PLUGIN_VERSION} loaded`);
+
 init();
